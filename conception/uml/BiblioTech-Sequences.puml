skinparam sequenceActorBorderColor #E67E22
skinparam sequenceLifeLineBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825

title Diagramme de séquence – Connexion / Authentification JWT

actor "Utilisateur" as USER
participant "React\n(Frontend)" as FRONT
participant "AuthController\n(Symfony)" as AUTH
participant "UtilisateurRepository" as REPO
participant "JWTManager\n(LexikJWT)" as JWT
database "PostgreSQL\n(Supabase)" as DB

USER -> FRONT : Saisit email + mot de passe\nclique "Se connecter"
FRONT -> AUTH : POST /api/login\n{ email, password }

AUTH -> REPO : findByEmail(email)
REPO -> DB : SELECT * FROM utilisateurs\nWHERE email = ?
DB --> REPO : Utilisateur (ou null)
REPO --> AUTH : Utilisateur

alt Utilisateur introuvable
    AUTH --> FRONT : 401 { message: "Identifiants invalides" }
    FRONT --> USER : Affiche erreur
else Mot de passe incorrect
    AUTH -> AUTH : password_verify(password,\nhashed_password) → false
    AUTH --> FRONT : 401 { message: "Identifiants invalides" }
    FRONT --> USER : Affiche erreur
else Compte désactivé (actif = false)
    AUTH --> FRONT : 403 { message: "Compte désactivé" }
    FRONT --> USER : Affiche erreur
else Authentification réussie
    AUTH -> JWT : createToken(Utilisateur)
    note right of JWT : Payload JWT :\n{ sub: id, email,\nrole, bibliotheque_id,\nexp: now + 3600s }
    JWT --> AUTH : token (JWT signé)
    AUTH --> FRONT : 200 {\n  token: "eyJ...",\n  user: { id, nom, prenom,\n  email, role, bibliotheque_id }\n}
    FRONT -> FRONT : Stocke JWT en localStorage\nStocke user dans contexte React
    FRONT --> USER : Redirige vers dashboard\nselon rôle (admin / biblio / adhérent)
end

== Requête authentifiée ultérieure ==

USER -> FRONT : Navigue vers une page protégée
FRONT -> AUTH : GET /api/exemplaires\nAuthorization: Bearer {JWT}
AUTH -> JWT : verify(token)

alt Token expiré ou invalide
    JWT --> AUTH : TokenExpiredException
    AUTH --> FRONT : 401 { message: "Token expiré" }
    FRONT --> USER : Redirige vers /login
else Token valide
    JWT --> AUTH : Payload décodé (role, bibliotheque_id)
    AUTH -> AUTH : Vérifie les droits RBAC\n(role + bibliotheque_id)
    AUTH --> FRONT : 200 { data: [...] }
    FRONT --> USER : Affiche les données
end

@enduml
