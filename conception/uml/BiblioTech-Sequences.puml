@startuml BiblioTech-Sequence-Pret
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #3B5998
skinparam sequenceParticipantBackgroundColor #EEF4FF
skinparam sequenceActorBackgroundColor #FDEBD0
skinparam sequenceActorBorderColor #E67E22
skinparam sequenceLifeLineBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825

title Diagramme de séquence – Enregistrer un prêt

actor "Bibliothécaire" as BIBLIO
participant "React\n(Frontend)" as FRONT
participant "PretController\n(Symfony)" as CTRL
participant "PretService\n(Symfony)" as SVC
participant "ExemplaireRepository" as REPO_EX
participant "PretRepository" as REPO_PR
database "PostgreSQL\n(Supabase)" as DB

== Authentification préalable ==
note over BIBLIO, FRONT: Bibliothécaire déjà connecté\nJWT valide en localStorage

== Enregistrement du prêt ==

BIBLIO -> FRONT : Saisit ISBN ou id_exemplaire\n+ id_adhérent + date_retour_prevue
FRONT -> CTRL : POST /api/prets\nAuthorization: Bearer {JWT}\n{exemplaire_id, adherent_id, date_retour_prevue}

CTRL -> CTRL : Valide le JWT\n(LexikJWT)
CTRL -> SVC : enregistrerPret(dto)

group Vérification exemplaire
    SVC -> REPO_EX : findById(exemplaire_id)
    REPO_EX -> DB : SELECT * FROM exemplaires\nWHERE id = ?
    DB --> REPO_EX : Exemplaire
    REPO_EX --> SVC : Exemplaire

    alt Exemplaire non trouvé
        SVC --> CTRL : ExemplaireNotFoundException
        CTRL --> FRONT : 404 { message: "Exemplaire introuvable" }
        FRONT --> BIBLIO : Affiche erreur
    else Statut ≠ "disponible"
        SVC --> CTRL : ExemplaireIndisponibleException
        CTRL --> FRONT : 409 { message: "Exemplaire non disponible" }
        FRONT --> BIBLIO : Affiche erreur
    end
end

group Création du prêt
    SVC -> REPO_PR : create(Pret)
    REPO_PR -> DB : INSERT INTO prets\n(exemplaire_id, adherent_id,\nbibliotheque_id, date_emprunt,\ndate_retour_prevue, statut)\nVALUES (...)
    DB --> REPO_PR : Pret créé (id)
    REPO_PR --> SVC : Pret

    SVC -> REPO_EX : updateStatut(exemplaire_id, "emprunte")
    REPO_EX -> DB : UPDATE exemplaires\nSET statut = 'emprunte'\nWHERE id = ?
    DB --> REPO_EX : OK
    REPO_EX --> SVC : OK
end

SVC --> CTRL : PretDTO (id, dates, statut)
CTRL --> FRONT : 201 Created\n{ pret: PretDTO }
FRONT --> BIBLIO : Affiche confirmation\n"Prêt enregistré – retour prévu le JJ/MM/AAAA"

@enduml


